diff --git a/vllm/model_executor/layers/quantization/mixllm.py b/vllm/model_executor/layers/quantization/mixllm.py
new file mode 100644
index 000000000..8c6e7ab83
--- /dev/null
+++ b/vllm/model_executor/layers/quantization/mixllm.py
@@ -0,0 +1,154 @@
+from typing import Any, Dict, List, Optional
+
+import torch
+from torch.nn.parameter import Parameter
+
+from vllm.logger import init_logger
+from vllm.model_executor.layers.linear import LinearBase, LinearMethodBase
+from vllm.model_executor.layers.quantization.base_config import (
+    QuantizationConfig)
+from vllm.model_executor.utils import set_weight_attrs
+import torch.nn.functional as F
+from pymixllm.utils import bcolors, weight_quantize
+from pymixllm import LinearMixLLM
+
+logger = init_logger(__name__)
+
+class MixLLMConfig(QuantizationConfig):
+    """Config class for MixLLM
+    
+    Reference: 
+    """
+
+    def __init__(
+        self,
+        ratio,
+    ) -> None:
+        self.ratio = ratio
+
+    def __repr__(self) -> str:
+        return "MixLLMConfig(ratio={})".format(
+            self.ratio)
+
+    @classmethod
+    def get_name(cls) -> str:
+        return "mixllm"
+
+    @classmethod
+    def get_supported_act_dtypes(cls) -> List[torch.dtype]:
+        return [torch.half]
+
+    @classmethod
+    def get_min_capability(cls) -> int:
+        return 80
+
+    @classmethod
+    def get_config_filenames(cls) -> List[str]:
+        """List of filenames to search for in the model directory."""
+        return [
+            "quant_config.json",
+            "quantize_config.json",
+        ]
+
+    @classmethod
+    def from_config(cls, config: Dict[str, Any]) -> "MixLLMConfig":
+        ratio = cls.get_from_keys(config, ["ratio"])
+        return cls(ratio)
+
+    def get_quant_method(self, layer: torch.nn.Module,
+                         prefix: str) -> Optional["MixLLMLinearMethod"]:
+        if isinstance(layer, LinearBase):
+            return MixLLMLinearMethod(self)
+        return None
+
+
+class MixLLMLinearMethod(LinearMethodBase):
+    """Linear method for MixLLM.
+
+    Args:
+        quant_config: The MixLLM quantization config.
+    """
+    lmixllm: LinearMixLLM
+
+    def __init__(self, quant_config: MixLLMConfig):
+        self.quant_config = quant_config
+
+    def create_weights(
+            self, layer: torch.nn.Module,
+            input_size_per_partition: int,
+            output_partition_sizes: List[int], input_size: int,
+            output_size: int, params_dtype: torch.dtype,
+            **extra_weight_attrs
+    ):        
+        qweight = Parameter(torch.empty(sum(output_partition_sizes),
+                                       input_size_per_partition,
+                                       dtype=torch.int8),
+                           requires_grad=False)
+        scale = Parameter(torch.empty(qweight.shape[1]//128, sum(output_partition_sizes), dtype=torch.float16), requires_grad=False)
+        zero = Parameter(torch.empty(qweight.shape[1]//128, sum(output_partition_sizes), dtype=torch.uint8), requires_grad=False)
+        indices = Parameter(torch.empty(sum(output_partition_sizes), dtype=torch.int32), requires_grad=False)
+        is_int8_channel = Parameter(torch.empty(sum(output_partition_sizes), dtype=torch.bool), requires_grad=False)
+
+        layer.register_parameter("qweight", qweight)
+        layer.register_parameter("scale", scale)
+        layer.register_parameter("zero", zero)
+        layer.register_parameter("indices", indices)
+        layer.register_parameter("is_int8_channel", is_int8_channel)
+
+        set_weight_attrs(qweight, {"input_dim": 1, "output_dim": 0})
+        set_weight_attrs(qweight, extra_weight_attrs)
+        set_weight_attrs(scale, extra_weight_attrs)
+        set_weight_attrs(scale, {"input_dim": 0, "output_dim": 1})
+        set_weight_attrs(zero, extra_weight_attrs)
+        set_weight_attrs(zero, {"input_dim": 0, "output_dim": 1})
+        set_weight_attrs(indices, extra_weight_attrs)
+        set_weight_attrs(indices, {"input_dim": 0, "output_dim": 0})
+        set_weight_attrs(is_int8_channel, extra_weight_attrs)
+        set_weight_attrs(is_int8_channel, {"input_dim": 0, "output_dim": 0})
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        if hasattr(layer, 'output_partition_sizes'):
+            idx = 0
+            for i in layer.output_partition_sizes:
+                idx += i
+                layer.indices[idx:] += i
+        is_int8_channel = layer.is_int8_channel
+        is_int4_channel = layer.is_int8_channel.logical_not()
+
+        weight_int8 = layer.qweight[is_int8_channel,:].contiguous()
+        weight_int4 = layer.qweight[is_int4_channel,:].contiguous()
+        del layer.qweight
+
+        weight_scale_int8 = layer.scale[:,is_int8_channel].contiguous()
+        weight_scale_int4 = layer.scale[:,is_int4_channel].contiguous()
+        del layer.scale
+
+        weight_zero_int4 = layer.zero[:,is_int4_channel].contiguous()
+        del layer.zero
+
+        indices_int8 = layer.indices[is_int8_channel].contiguous()
+        indices_int4 = layer.indices[is_int4_channel].contiguous()
+        del layer.indices
+        del layer.is_int8_channel
+        torch.cuda.empty_cache()
+        
+        self.lmixllm = LinearMixLLM(
+                 weight_int8 = weight_int8,
+                 weight_int4 = weight_int4,
+                 weight_scale_int8 = weight_scale_int8,
+                 weight_scale_int4 = weight_scale_int4,
+                 weight_zero_int4 = weight_zero_int4,
+                 indices_int8 = indices_int8,
+                 indices_int4 = indices_int4)
+
+
+    def apply(
+        self,
+        layer: torch.nn.Module,
+        x: torch.Tensor,
+        bias: Optional[torch.Tensor] = None,
+    ) -> torch.Tensor:
+        output = self.lmixllm.forward(x)
+        if bias is not None:
+            output.add_(bias)
+        return output
