@@ -0,0 +1,48 @@
+from vllm import LLM, SamplingParams
+import torch
+import os
+from vllm.model_executor.layers.quantization import get_quantization_config
+
+# os.environ["VLLM_TORCH_PROFILER_DIR"] = "./vllm_profile"
+
+# Sample prompts.
+prompts = [
+    "Hello, my name is",
+    "The president of the United States is",
+    "The capital of France is",
+    "The future of AI is",
+]
+# Create a sampling params object.
+sampling_params = SamplingParams(temperature=0, top_p=0.9, top_k=50, repetition_penalty=1.0)
+
+# Create an LLM.
+
+# mistralai/Mistral-7B-v0.1 #facebook/opt-125m  "../quantized_model/Mistral-7B-v0.1"  "Qwen/Qwen2.5-1.5B-Instruct" ../quantized_model/Qwen/Qwen2.5-1.5B/0.1/
+print("********************************* init *********************************") 
+# llm = LLM(model="Qwen/Qwen2.5-7B", enforce_eager=False)
+llm = LLM(model="../quantized_model/Qwen/Qwen2.5-7B/1.0/", enforce_eager=False)
+# llm = LLM(model="../quantized_model/mistralai/Mistral-7B-v0.3/0.1/", enforce_eager=False) 
+# llm = LLM(model="mistralai/Mistral-7B-v0.1", enforce_eager=False) 
+# llm = LLM(model="../quantized_model/Qwen/Qwen2.5-7B/1.0/", enforce_eager=False)
+
+
+# ../quantized_model/mistralai/Mistral-7B-v0.3/1.0/
+# llm = LLM(model="mistralai/Mistral-7B-v0.1", dtype=torch.float16, enforce_eager=False)
+# llm = LLM(model="TheBloke/Llama-2-7b-Chat-AWQ", quantization="qqq")
+# Generate texts from the prompts. The output is a list of RequestOutput objects
+# that contain the prompt, generated text, and other information.
+
+print("********************************* generate *****************************")
+torch.cuda.synchronize()
+torch.cuda.nvtx.range_push("llm.generate")
+# llm.start_profile()
+outputs = llm.generate(prompts, sampling_params)
+# llm.stop_profile()
+torch.cuda.synchronize()
+torch.cuda.nvtx.range_pop()
+
+# Print the outputs.
+for output in outputs:
+    prompt = output.prompt
+    generated_text = output.outputs[0].text
+    print(f"Prompt: {prompt!r}, Generated text: {generated_text!r}")
