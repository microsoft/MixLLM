+# 参数变量定义
+MODEL_W16A16="Qwen/Qwen2.5-7B"
+MODEL_W8A8="../quantized_model/Qwen/Qwen2.5-7B/1.0/"
+MODEL_W44A8="../quantized_model/Qwen/Qwen2.5-7B/0.1/"
+MODEL_W4A8="../quantized_model/Qwen/Qwen2.5-7B/0/"
+MODEL_W16A16_15B="Qwen/Qwen2.5-1.5B"
+ADD_BOS_TOKEN=true
+MAX_NUM_SEQS=512
+TASKS="gsm8k"
+NUM_FEWSHOT=5
+LIMIT=250
+BATCH_SIZE=32
+LOG_FILE="gsm8k_eval.log"
+CSV_FILE="gsm8k_result.csv"
+
+# 写入表头
+echo "model,flexible-extract,strict-match" > $CSV_FILE
+
+for MODEL in \
+    "$MODEL_W16A16" \
+    "$MODEL_W8A8" \
+    "$MODEL_W44A8" \
+    "$MODEL_W4A8" \
+    "$MODEL_W16A16_15B"
+do
+    lm_eval --model vllm --model_args pretrained=$MODEL,add_bos_token=$ADD_BOS_TOKEN,max_num_seqs=$MAX_NUM_SEQS --tasks $TASKS --num_fewshot $NUM_FEWSHOT --limit $LIMIT --batch_size $BATCH_SIZE > $LOG_FILE 2>&1
+
+    FLEXIBLE=$(awk -F'|' '/\|gsm8k\|/ {gsub(/^[ \t]+|[ \t]+$/, "", $7); print $8}' $LOG_FILE)
+    STRICT=$(awk -F'|' '/\|     \|/ {gsub(/^[ \t]+|[ \t]+$/, "", $8); print $8}' $LOG_FILE)
+    echo "$MODEL,$FLEXIBLE,$STRICT" >> $CSV_FILE
+done
